{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"ignore": [
			".git/**",
			".github/**",
			".next/**",
			".vscode/**",
			"node_modules/**",
			"playwright-report/**",
			"next/**",
			"next-end.d.ts"
		]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"ignore": [
			".git/**",
			".github/**",
			".next/**",
			".vscode/**",
			"node_modules/**",
			"playwright-report/**",
			"next/**",
			"next-end.d.ts"
		],
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": {
					"level": "error"
				},
				"noUnusedImports": {
					"level": "error"
				}
			}
		}
	}
}